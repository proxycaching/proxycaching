{
  "proxy": {
    "port": 8080,
    "adminPort": 8081,
    "podcachePath": "C:\\Users\\TEST\\Documents\\proxycaching\\podcache",
    "adminEnabled": true,
    "mitmEnabled": true,
    "encryption": {
      "enabled": false,
      "algorithm": "aes-256-gcm",
      "keyEnvVar": "PODCACHE_ENCRYPTION_KEY"
    },
    "sse": {
      "enabled": true,
      "simulateTiming": true
    },
    "logging": {
      "level": "info"
    }
  },
  "rules": [
    {
      "name": "anthropic-api-url-grouping",
      "match": {
        "method": [
          "POST"
        ],
        "domains": [
          "api.anthropic.com"
        ],
        "paths": [
          "/v1/messages"
        ]
      },
      "cache": true,
      "groupBy": "url-only"
    },
    {
      "name": "default",
      "match": {
        "method": [
          "GET",
          "POST"
        ],
        "domains": [
          "*"
        ],
        "paths": [
          "*"
        ],
        "query": {}
      },
      "cache": true
    }
  ]
}