{
  "name": "proxycaching",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "mitm-init": "node dist/scripts/mitmInit.js",
    "mitm-export": "node dist/scripts/mitmExport.js",
    "mitm-install-windows": "node dist/scripts/mitmInstallWindows.js",
    "mitm-install": "npm run mitm-install-windows"
  },
  "dependencies": {
    "express": "^4.18.2",
    "http-mitm-proxy": "^0.8.1",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.18",
    "@types/node": "^20.11.0",
    "@types/node-forge": "^1.3.14",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
